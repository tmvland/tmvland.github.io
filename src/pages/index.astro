---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <!-- <div class="text-xl py-1">Hey there 👋</div> -->
    <div class="text-5xl font-bold">Welcome!</div>
    <div class="text-3xl py-3 font-bold">Theo Landman, computational medical physicist</div>
    <div class="py-2">
      <text class="text-lg">
        Hello! I am Theo Landman, and I am a current Master's student in Biomedical Imaging at the University of California, San Francisco. I hold a Bachelor's degree from the University of Michigan in mathematics, physics, and complex systems. My primary research interest is in the development of image processing software for biomedical imaging. I'm also very interested in the intersection of machine learning and biomedical image processing. I'm interested in the application of scientific computing to physical models.  I love differential equations, and will talk about them at pretty much any available opportunity. 


Right now I'm mainly working on edge-detection methods for synthetic CT generation. Stuff related to that might crop up on here-- or other image reconstruction codes I want to keep hold of for later. 

      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/theo-landman-31397725a" target="_blank"> Let's connect!</a>
      <a href="https://github.com/tmvland" target="_blank"> GitHub
      </a> 
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My latest projects {"</>"}</div>
  </div>


  <HorizontalCard
    title="Synthetic CT Image Quality evaluation toolset"
    img="/gallstone.png"
    desc="Developing a set of QA tools for pipeline-agnostic synthetic CT generation in the interest of advancing MR-only workflows in radiotherapy. Image similarity assessed via structural similarity image measure (SSIM) and analysis of Jacobian transform matrix."
    url="https://github.com/tmvland/MSBI-research" target="_blank" />
 <div class="divider my-0"></div>
  <HorizontalCard
    title="PET-Sinogram converter"
    img="/sinogram.png"
    desc="Converting raw PET data into simulated sinogram data using the Radon forward projection for use in image reconstruction."
    url="https://github.com/tmvland/forward-proj" target="_blank" />
 <div class="divider my-0"></div>
   <HorizontalCard
    title="Validating a data-driven approach to scheduling office hours"
    img="/ASEE.png"
    desc="Published a paper in the ASEE 2025 conference proceedings quantifying data-driven changes made to office hours for a large required first-year engineering course that I coordinated for three years."
    url="https://nemo.asee.org/public/conferences/365/papers/45859/view" />

  <div class="divider my-0"></div>
  <HorizontalCard
    title="Chaotic waterwheel simulator"
    img="/malkus.png"
    desc="Model of Malkus' chaotic waterwheel, using RK4 with adjustable parameters."
    url="https://github.com/tmvland/chaos" target="_blank" />


  <!-- <div class="divider my-0"></div>
  <HorizontalCard
    title="Demo Project 3"
    img="/post_img.webp"
    desc="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    url="#"
    badge="FOSS"
  /> -->

